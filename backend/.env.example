DJANGO_SETTINGS_MODULE=config.settings.dev

DEBUG=True
SECRET_KEY=dev-only-insecure-secret-key-change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (WSL) / Redis (WSL)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/multistore
REDIS_URL=redis://127.0.0.1:6379/0

# Celery
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# Origins allowed to call the API from a browser (dashboard, customer web)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Base URL used in password-reset links
FRONTEND_URL=http://localhost:5173

# Dashboards bucket a day by this zone, not by UTC
REPORT_TIME_ZONE=Asia/Damascus

# Email (console in dev; wire real provider in prod)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@multi-store.local
