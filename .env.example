# Values docker-compose.yml reads. Copy to .env for a local run; on Coolify the
# same names go under the resource's Environment Variables.
#
# `.env` is gitignored. This example is the committed one.

# Generate one: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=dev-only-insecure-secret-key-change-me

# The deployed hostname. Use the real domain in production; `*` is for a first
# deploy only.
ALLOWED_HOSTS=*

# Postgres credentials for the `db` service.
POSTGRES_DB=multistore
POSTGRES_USER=multistore
POSTGRES_PASSWORD=multistore

# Browser origins allowed to call the API (the React dashboard).
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Days are bucketed in this zone, not UTC.
REPORT_TIME_ZONE=Asia/Damascus

# The API docs. Empty means the docs answer 404 in production.
DOCS_AUTH_USER=docs
DOCS_AUTH_PASSWORD=change-me-before-deploying

# True once the API is behind a TLS-terminating proxy (Coolify does this).
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
