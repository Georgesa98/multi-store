# Values docker-compose.yml reads. Copy to .env for a local run; on Coolify the
# same names go under the resource's Environment Variables.
#
# `.env` is gitignored. This example is the committed one, and it is filled in
# for the deployment at https://multi-store.georgesalebe.me.

# Generate one: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=dev-only-insecure-secret-key-change-me

# The public hostname, plus loopback for the in-container healthcheck.
ALLOWED_HOSTS=multi-store.georgesalebe.me,localhost,127.0.0.1

# Postgres credentials for the `db` service.
POSTGRES_DB=multistore
POSTGRES_USER=multistore
POSTGRES_PASSWORD=multistore

# The dashboard's browser origin — not the API host, which needs no CORS entry.
# The React dashboard is not deployed yet, so this is still the dev server.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Django's CSRF check for the https origin.
CSRF_TRUSTED_ORIGINS=https://multi-store.georgesalebe.me

# Base URL for password-reset links; points at the client app, not the API.
FRONTEND_URL=http://localhost:5173

# Days are bucketed in this zone, not UTC.
REPORT_TIME_ZONE=Asia/Damascus

# The API docs at /api/docs/. Empty means 404 in production — so set both, and
# do not ship the example password.
DOCS_AUTH_USER=docs
DOCS_AUTH_PASSWORD=change-me-before-deploying

# Coolify's Traefik terminates TLS, so keep this True there. A plain-http local
# run needs False, or every request 301s to a port that does not speak TLS.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
